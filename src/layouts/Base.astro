---
import { alternatesByUrl } from '../data/insight-alternates';
import { pageAlternatesByUrl } from '../data/page-alternates';

export interface Props {
  title: string;
  description: string;
  lang?: string;
  schema?: object;
  canonicalUrl?: string;
  image?: string;
  author?: string;
  datePublished?: string;
  alternates?: Record<string, string>;
}

const { title, description, lang = 'sv', schema, canonicalUrl, author, datePublished, image, alternates } = Astro.props;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const buildDate = new Date();
const monthsSv = ['januari','februari','mars','april','maj','juni','juli','augusti','september','oktober','november','december'];
const monthsEn = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const monthsEs = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const updatedLabel = lang === 'sv'
  ? `Senast uppdaterad ${buildDate.getDate()} ${monthsSv[buildDate.getMonth()]} ${buildDate.getFullYear()}`
  : lang === 'es'
  ? `Última actualización: ${buildDate.getDate()} de ${monthsEs[buildDate.getMonth()]} de ${buildDate.getFullYear()}`
  : `Last updated ${buildDate.getDate()} ${monthsEn[buildDate.getMonth()]} ${buildDate.getFullYear()}`;

const allLangs = ['sv', 'en', 'es'];
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const alternateMap: Record<string, string> | undefined =
  alternates ?? alternatesByUrl[pathname] ?? pageAlternatesByUrl[pathname];
const alternateLinks = (alternateMap ? allLangs.filter(l => alternateMap[l]) : allLangs).map(l => ({
  lang: l,
  href: new URL(alternateMap?.[l] ?? pathname.replace(`/${lang}/`, `/${l}/`), Astro.site).href
}));
const defaultHref = (alternateLinks.find(a => a.lang === 'sv') ?? alternateLinks[0])?.href;

const contactHref = lang === 'sv' ? '/sv/kontakt/' : lang === 'en' ? '/en/contact/' : '/es/contacto/';
const contactLabel = lang === 'sv' ? 'Kontakt' : lang === 'en' ? 'Contact' : 'Contacto';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    {defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1280" />}
    {ogImage && <meta property="og:image:height" content="720" />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    <meta name="indexnow-key" content="3f1f8c80737691d9e35e6fd40591fd53" />
    <meta name="google-site-verification" content="Tvey2t9929lVMy38oRywdNCBTabYIcjP0jDKQEXPKo4" />
    {author && <meta name="author" content={author} />}
    {datePublished && <meta property="article:published_time" content={datePublished} />}
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --color-bg: #ffffff;
        --color-text: #1a1a1a;
        --color-text-muted: #555;
        --color-accent: #0057b8;
        --color-accent-hover: #003d82;
        --color-border: #e5e5e5;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --max-width: 760px;
        --space-xs: 0.5rem;
        --space-sm: 1rem;
        --space-md: 2rem;
        --space-lg: 4rem;
      }
      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.7;
        font-size: 1.05rem;
      }
      a { color: var(--color-accent); text-decoration: none; }
      a:hover { color: var(--color-accent-hover); text-decoration: underline; }
      nav {
        border-bottom: 1px solid var(--color-border);
        padding: var(--space-sm) var(--space-md);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-sm);
      }
      nav .logo { font-weight: 700; font-size: 1.1rem; color: var(--color-text); }
      nav .logo:hover { text-decoration: none; }
      nav ul { list-style: none; display: flex; gap: var(--space-md); flex-wrap: wrap; }
      nav ul li a { color: var(--color-text-muted); font-size: 0.95rem; }
      nav ul li a:hover { color: var(--color-accent); text-decoration: none; }
      /* Undermeny. Oppnas pa hover och pa tangentbordsfokus, sa den gar att na
         utan mus. Pa smala skarmar finns ingen hover, darfor ligger den alltid
         utfalld dar i stallet. */
      nav li.has-sub { position: relative; }
      nav li.has-sub > ul {
        display: none;
        position: absolute;
        top: 100%;
        left: -0.75rem;
        flex-direction: column;
        gap: 0.5rem;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 4px;
        padding: 0.75rem 1rem;
        margin-top: 0.5rem;
        min-width: 11rem;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.07);
        z-index: 10;
      }
      nav li.has-sub:hover > ul,
      nav li.has-sub:focus-within > ul { display: flex; }
      @media (max-width: 767px) {
        /* Ingen hover pa pekskarm. Undermenyn plattas darfor ut till vanliga
           menyval i samma rad. Forsta posten doljs eftersom den bara upprepar
           foraldralanken. */
        nav li.has-sub { display: flex; flex-wrap: wrap; gap: var(--space-md); }
        nav li.has-sub > ul {
          display: flex;
          position: static;
          flex-direction: row;
          gap: var(--space-md);
          background: none;
          border: 0;
          box-shadow: none;
          padding: 0;
          margin: 0;
          min-width: 0;
        }
        nav li.has-sub > ul > li:first-child { display: none; }
      }
      main { max-width: var(--max-width); margin: 0 auto; padding: var(--space-lg) var(--space-md); }
      h1 { font-size: 2.2rem; line-height: 1.2; margin-bottom: var(--space-md); font-weight: 800; }
      h2 { font-size: 1.5rem; line-height: 1.3; margin: var(--space-md) 0 var(--space-sm); font-weight: 700; }
      h3 { font-size: 1.15rem; margin: var(--space-sm) 0 var(--space-xs); font-weight: 600; }
      p { margin-bottom: var(--space-sm); color: var(--color-text); }
      ul, ol { padding-left: 1.5rem; margin-bottom: var(--space-sm); }
      li { margin-bottom: var(--space-xs); }
      .lead { font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: var(--space-md); }
      .btn {
        display: inline-block;
        background: var(--color-accent);
        color: #fff;
        padding: 0.75rem 1.75rem;
        border-radius: 4px;
        font-weight: 600;
        margin-top: var(--space-sm);
      }
      .btn:hover { background: var(--color-accent-hover); text-decoration: none; color: #fff; }
      .section { margin-bottom: var(--space-lg); }
      .hero-img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 6px;
        margin: 0 0 var(--space-md);
        background: #f0f0f0;
      }
      footer {
        border-top: 1px solid var(--color-border);
        padding: var(--space-md);
        text-align: center;
        color: var(--color-text-muted);
        font-size: 0.9rem;
      }
      footer a { color: var(--color-text-muted); }
    </style>
  </head>
  <body>
    <nav>
      <a href={`/${lang}/`} class="logo">Urban Gavelin</a>
      <ul>
        {lang === 'sv' ? (
          <>
            <li><a href="/sv/urban-gavelin/">Om Urban</a></li>
            <li class="has-sub">
              <a href="/sv/forsaljningstransformation/">Erbjudande</a>
              <ul>
                <li><a href="/sv/forsaljningstransformation/">Hela erbjudandet</a></li>
                <li><a href="/sv/veckotakten/">Veckotakten</a></li>
              </ul>
            </li>
            <li><a href="/sv/expertomraden/">Expertområden</a></li>
            <li><a href="/sv/insikter/">Insikter</a></li>
            <li><a href="/sv/kontakt/">Kontakt</a></li>
            <li><a href="/en/">EN</a></li>
            <li><a href="/es/">ES</a></li>
          </>
        ) : lang === 'en' ? (
          <>
            <li><a href="/en/urban-gavelin/">About</a></li>
            <li><a href="/en/sales-transformation/">Services</a></li>
            <li><a href="/en/expertise/">Expertise</a></li>
            <li><a href="/en/insights/">Insights</a></li>
            <li><a href="/en/contact/">Contact</a></li>
            <li><a href="/sv/">SV</a></li>
            <li><a href="/es/">ES</a></li>
          </>
        ) : (
          <>
            <li><a href="/es/urban-gavelin/">Sobre Urban</a></li>
            <li><a href="/es/areas-de-expertise/">Experiencia</a></li>
            <li><a href="/es/ai-sales-os/">AI-Sales OS</a></li>
            <li><a href="/es/perspectivas/">Perspectivas</a></li>
            <li><a href="/es/contacto/">Contacto</a></li>
            <li><a href="/sv/">SV</a></li>
            <li><a href="/en/">EN</a></li>
          </>
        )}
      </ul>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <p>Urban Gavelin, <a href="https://powersales.se">Powersales Communication</a>, <a href="https://www.youtube.com/@PSCBusinessAcademy">YouTube</a>, <a href={contactHref}>{contactLabel}</a></p>
      <p style="margin-top: 0.5rem; font-size: 0.8rem;">{updatedLabel}</p>
    </footer>
  </body>
</html>
