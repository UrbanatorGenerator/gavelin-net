  "name": "Urban Gavelin",
  "jobTitle": "B2B-rådgivare, säljtränare och grundare av Powersales Communication",
  "description": "Urban Gavelin är svensk B2B-rådgivare och säljtränare med fokus på försäljning, kommunikation och AI-stödda säljsystem för B2B-företag.",
  "url": "https://gavelin.net/sv/urban-gavelin/",
  "nationality": "Swedish",
  "knowsAbout": [
    "B2B-försäljning",
    "säljledning",
