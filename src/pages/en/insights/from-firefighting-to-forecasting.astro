<Base
  title="From Firefighting to Forecasting: Reclaim Your Time as a Sales Leader | Urban Gavelin"
  description="Most sales leaders spend 80% of their time firefighting and 20% on strategy. Here's how to flip that ratio using the D.E.A.L. framework, and what one Stockholm SaaS company achieved in three months."
  lang="en"
  schema={schema}
